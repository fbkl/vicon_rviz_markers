<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<launch>
	<arg name="freq" default="100" />
	<arg name="imu_observation_order" default="['thorax','radius']"/>
	<arg name="model_file" 		default="/srv/shared/MOBL/MOBL_ARMS_41.osim" />
	<include file="$(find osrt_ros)/launch/ik_from_orientation_providers.xml">
		<arg name="name_tag" 		  value="vicon_upper"/>
		<arg name="use_position_markers"		  value="true"/>
		<arg name="use_orientation_markers"		  value="false"/>
		<arg name="model_file" 		  value="$(arg model_file)" />
		<arg name="freq" 		  value="$(arg freq)" />
		<!-- marker,tf -->
		<arg name="point_getter_type" 		  value="marker"/>
	</include>
</launch>

